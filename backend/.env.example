OPENAI_API_KEY=
DRY_RUN=true
MAX_PORTFOLIO_RISK_PCT=0.05
MAX_POSITION_SIZE_USD=1000
PAPER_CASH_USD=20000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Persistent DB path — required on Render so pause state and research survive restarts
# Render (render.yaml): /var/data/orders.db
# Local: backend/data/orders.db
DUCKDB_PATH=
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_AUTH_MODE=personal
PORTFOLIO_REDIRECT_URL=https://your-app.onrender.com
